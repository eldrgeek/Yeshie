.DS_Store
logs/
chain-result.json

# Local dependency installs
node_modules/
packages/relay/node_modules/
packages/extension/node_modules/

# Extension build outputs and caches
packages/extension/.output/
packages/extension/.wxt/
packages/extension/.build/
packages/extension/.vite/
packages/extension/.web-extension-id
packages/extension/background.js

# Local watcher state
packages/extension/.build-count
packages/extension/.cache/

# Secrets — never commit (WXT env files carry the SOMA admin token at build time)
packages/extension/.env
packages/extension/.env.*
!packages/extension/.env.example

# Scratch backups + caches (session detritus, not source)
*.bak
*.bak-*
*.ext-*.bak
__pycache__/
.ntm/

# Runtime state (regenerated by the relay)
packages/relay/jobs-state.json

# Ephemeral Claude Code Agent-tool isolation:worktree runs — never commit these
# as gitlinks (no .gitmodules ever existed; they were tracked accidentally).
# Cleaned up 2026-07-11: 18 stale gitlink entries removed from tracking (dirs
# left on disk, some with real uncommitted work — see git log for this commit).
.claude/worktrees/
