{
  "_meta": {
    "task": "submit-prompt",
    "description": "Submit a prompt to Google Gemini and capture the response.",
    "params": {
      "prompt": {
        "required": true,
        "description": "The prompt/question to send to Gemini",
        "hint": "Can be any length. For multi-line, use newlines in the string."
      },
      "base_url": {
        "required": false,
        "default": "https://gemini.google.com/app",
        "description": "URL to navigate to before submitting. Use default for new conversation.",
        "hint": "Can point to an existing Gemini conversation to continue a thread"
      }
    },
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null
  },
  "params": {
    "base_url": "https://gemini.google.com/app",
    "prompt": "Say hello in exactly one sentence."
  },
  "abstractTargets": {
    "prompt_input": {
      "description": "Gemini rich-textarea contenteditable input",
      "anchors": {
        "ariaLabel": "Enter a prompt here",
        "placeholder": "Enter a prompt here"
      },
      "fallbackSelectors": [
        "[aria-label='Enter a prompt here']",
        "rich-textarea div[contenteditable='true']",
        "div[contenteditable='true'][role='textbox']",
        "div[contenteditable='true']"
      ]
    }
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "assess_state",
      "stateGraph": {
        "nodes": {
          "auth_required": {
            "signals": [
              {
                "type": "url_matches",
                "pattern": "accounts\\.google\\.com"
              }
            ]
          }
        }
      },
      "onMismatch": "continue",
      "note": "Check for Google auth redirect"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "target": "prompt_input",
      "state": {
        "visible": true
      },
      "timeout": 8000,
      "note": "wait for prompt_input before next step (was delay 800ms)"
    },
    {
      "stepId": "s3",
      "action": "type",
      "target": "prompt_input",
      "value": "{{prompt}}",
      "submit": true,
      "note": "Type prompt and press Enter"
    },
    {
      "stepId": "s4",
      "action": "wait_for",
      "selector": "button[aria-label='Stop response']",
      "state": {
        "visible": true
      },
      "timeout": 8000,
      "note": "wait for button[aria-label='Stop response'] before next step (was delay 2000ms) [softened: redundant transient wait]",
      "onTimeout": "continue"
    },
    {
      "stepId": "s5",
      "action": "wait_for",
      "selector": "button[aria-label='Stop response']",
      "state": {
        "visible": false
      },
      "timeout": 120000,
      "note": "Wait until Stop Response button disappears"
    },
    {
      "stepId": "s6",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 500ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s7",
      "action": "read",
      "candidates": [
        "model-response:last-of-type",
        ".response-container:last-child",
        "message-content:last-of-type"
      ],
      "store_as": "response",
      "note": "Capture last model response"
    }
  ],
  "site": "gemini.google.com",
  "mode": "exploratory"
}
