  "chain": [
    {
      "stepId": "h0",
      "action": "navigate",
      "url": "https://app.yeshid.com/organization/people",
      "note": "HOME START: Navigate to people list (not overview — overview has no people-count stat) before performing action."
    },
    {
      "stepId": "h0b",
      "action": "wait_for",
      "selector": "[data-cy=\"username\"]",
      "timeout": 5000,
      "note": "Wait for page to render — username data-cy is present on every authenticated page."
    },
    {
      "stepId": "h0c",
      "action": "js",
      "code": "paginationTotal()",
      "store_as": "initial_active_people",
      "note": "Read total people count from the Vuetify data-table footer ('1-10 of N') on /organization/people. Row-count-of-rendered-<tr> was tried first and found unreliable once the org has >10 people (page-size cap) — fixed 2026-07-10."
    },
    {
      "stepId": "s1",
      "action": "assess_state",
      "expect": {
        "state": "authenticated"
      },
      "onMismatch": "branch:not-authenticated"
    },
    {
      "stepId": "s2",
      "action": "navigate",
      "url": "{{base_url}}/organization/people",
      "note": "FIXED 2026-07-10: was navigating straight to /organization/people/onboard, which no longer renders the form live (confirmed via perceive survey — that URL redirects to the dashboard shell). Current flow is People list -> click 'Create person'."
    },
    {
      "stepId": "s2a",
      "action": "wait_for",
      "selector": "[data-cy=\"username\"]",
      "timeout": 6000,
      "note": "Wait for authenticated page chrome before clicking Create person."
    },
    {
      "stepId": "s2b0",
      "action": "click_text",
      "text": "Create person",
      "guard": {
        "target": "first-name-input",
        "state": {
          "visible": true
        },
        "timeout": 6000
      },
      "expect": {
        "state": "onboard-form"
      },
      "note": "Opens the create-person panel at /organization/people/create (in-app route, live-verified 2026-07-10)."
    },
    {
      "stepId": "s2b",
      "action": "click_preset",
      "target": "start-date-picker",
      "preset": "{{start_date_preset}}",
      "defaultPreset": "Immediately",
      "note": "FIXED 2026-07-10: live-verified the 'Select start date' button now opens a plain native date-picker calendar, not a text-preset menu (no 'Immediately'/'Monday morning'/'Pick date & time' options exist anymore — those were April 2026 UI). Both Start date and End date fields are labeled (Optional); leaving them blank onboards the person immediately, which covers the common 'Immediately' case. Marked optional so a failed preset-click (e.g. for 'Immediately', where there's nothing to click) doesn't hard-fail the run. TODO: 'Monday morning' / 'Pick date & date' presets need real calendar-widget automation — not implemented; recipe will currently just skip and onboard immediately regardless of the requested preset for those two options. Flagged, not solved, in this pass.",
      "optional": true
    },
    {
      "stepId": "s3",
      "action": "type",
      "target": "first-name-input",
      "value": "{{first_name}}",
      "guard": {
        "target": "first-name-input",
        "state": {
          "visible": true,
          "enabled": true
        }
      }
    },
    {
      "stepId": "s4",
      "action": "type",
      "target": "last-name-input",
      "value": "{{last_name}}",
      "guard": {
        "target": "last-name-input",
        "state": {
          "visible": true,
          "enabled": true
        }
      }
    },
    {
      "stepId": "s5",
      "action": "type",
      "target": "company-email-input",
      "value": "{{company_email}}",
      "guard": {
        "target": "company-email-input",
        "state": {
          "visible": true,
          "enabled": true
        }
      }
    },
    {
      "stepId": "s6",
      "action": "type",
      "target": "personal-email-input",
      "value": "{{backup_email}}",
      "guard": {
        "target": "personal-email-input",
        "state": {
          "visible": true,
          "enabled": true
        }
      },
      "note": "Personal / recovery email. Required by YeshID. Pass backup_email param."
    },
    {
      "stepId": "s7",
      "action": "click",
      "target": "create-onboard-button",
      "guard": {
        "target": "create-onboard-button",
        "state": {
          "visible": true,
          "enabled": true
        }
      },
      "responseSignature": [
        {
          "any_of": [
            {
              "type": "url_change",
              "matches": "/workflows/",
              "timeout": 12000,
              "note": "YeshID redirects to /workflows/UUID on successful onboard"
            },
            {
              "type": "url_change",
              "matches": "/organization/people$",
              "timeout": 12000
            },
            {
              "type": "element_visible",
              "selector": ".v-snackbar--active",
              "textMatch": "success|created|added|onboard",
              "timeout": 8000
            }
          ]
        }
      ],
      "failureSignature": [
        {
          "any_of": [
            {
              "type": "element_visible",
              "selector": ".v-snackbar--active",
              "textMatch": "Error|error|failed|required|invalid",
              "timeout": 5000
            },
            {
              "type": "element_visible",
              "selector": ".v-input--error",
              "timeout": 3000,
              "note": "Inline field validation error — one or more fields failed"
            },
            {
              "type": "element_text",
              "selector": ".v-messages__message, .v-input--error .v-messages",
              "textPattern": "required|invalid|must|fill",
              "timeout": 3000
            }
          ]
        }
      ]
    },
    {
      "stepId": "s7b",
      "action": "read",
      "candidates": [
        ".v-input--error .v-label",
        ".v-input--error label",
        ".v-messages__message"
      ],
      "store_as": "validation_errors",
      "optional": true,
      "note": "Read which fields have inline validation errors after submit. Only populated if s7 triggered failureSignature."
    },
    {
      "stepId": "s8b",
      "action": "assess_state",
      "expect": {
        "state_any": [
          "people-list",
          "onboard-workflow"
        ]
      },
      "note": "Verify redirect — success lands on /workflows/UUID (workflow kicked off) or /organization/people",
      "onMismatch": "report_failure"
    },
    {
      "stepId": "s8c",
      "action": "read",
      "candidates": [
        "h1",
        ".workflow-title",
        "title",
        ".v-snackbar--active .v-snackbar__content",
        ".v-toolbar__title"
      ],
      "store_as": "workflow_confirmation",
      "optional": true,
      "note": "VERIFY: Read page title or snackbar on workflow/people page to confirm user name was created."
    },
    {
      "stepId": "s8",
      "action": "read",
      "candidates": [
        ".v-snackbar--active .v-snackbar__content",
        ".v-snackbar .v-snackbar__content"
      ],
      "store_as": "confirmation_message",
      "minLength": 1,
      "note": "Capture the success/error message from the snackbar."
    },
    {
      "stepId": "hZ",
      "action": "navigate",
      "url": "https://app.yeshid.com/organization/people",
      "note": "HOME END: Return to people list (not overview) after action completes, to re-count rows."
    },
    {
      "stepId": "hZb",
      "action": "wait_for",
      "selector": "[data-cy=\"username\"]",
      "timeout": 5000,
      "note": "Wait for page to render — username data-cy is present on every authenticated page."
    },
    {
      "stepId": "hZc",
      "action": "js",
      "code": "paginationTotal()",
      "store_as": "final_active_people",
      "note": "Same as h0c, read after the onboard action. Should be initial_active_people.numericValue + 1 on success."
    }
  ],
  "branches": {
    "not-authenticated": {
      "description": "Not logged in — run login flow first.",
      "steps": [
        {
          "stepId": "b1",
          "action": "assert",
          "condition": "false",
          "message": "Not authenticated. The auth flow should handle login automatically."
        }
      ]
    }
  },
  "stateGraph": {
    "nodes": {
