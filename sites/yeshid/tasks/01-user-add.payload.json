          }
        ]
      },
      "events": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/events$"
          }
        ]
      },
      "onboard-workflow": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/workflows/[a-z0-9-]+"
          }
        ]
      },
      "overview": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/overview$"
          }
        ]
      }
    }
  }
