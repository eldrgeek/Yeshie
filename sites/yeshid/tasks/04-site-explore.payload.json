      "base_url"
    ],
    "selfImproving": true,
    "outputFile": "sites/yeshid/exploration-results.json",
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "sso_automatable",
      "googleAccountEmail": "mw@mike-wolf.com"
    }
  },
