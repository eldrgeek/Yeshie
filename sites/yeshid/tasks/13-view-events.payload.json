{
  "_meta": {
    "task": "view-events",
    "description": "Navigate to events page and optionally search for specific events.",
    "params": {
      "search_term": {
        "required": false,
        "default": "",
        "description": "Event search term (leave blank to show all recent events)"
      }
    },
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "sso_automatable",
      "googleAccountEmail": "mw@mike-wolf.com"
    },
    "requiredParams": [],
    "optionalParams": [
      "search_term"
    ]
  },
  "params": {
    "base_url": "https://app.yeshid.com",
    "search_term": ""
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "assess_state",
      "expect": {
        "state": "authenticated"
      },
      "onMismatch": "exit_with_error:not-authenticated"
    },
    {
      "stepId": "s2",
      "action": "navigate",
      "url": "{{base_url}}/events"
    },
    {
      "stepId": "s3",
      "action": "wait_for",
      "selector": "input[placeholder='Search']",
      "state": {
        "visible": true
      },
      "timeout": 8000,
      "note": "wait for input[placeholder='Search'] before next step (was delay 1500ms)"
    },
    {
      "stepId": "s4",
      "action": "type",
      "selector": "input[placeholder='Search']",
      "value": "{{search_term}}",
      "condition": "{{search_term}}",
      "note": "Search events if search_term provided"
    },
    {
      "stepId": "s5",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 1000ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s6",
      "action": "read",
      "selector": ".v-data-table",
      "store_as": "events_data",
      "note": "Capture events table"
    }
  ],
  "stateGraph": {
    "nodes": {
      "unauthenticated": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/login|/auth|/signin|accounts\\.google\\.com"
          }
        ]
      },
      "authenticated": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "app\\.yeshid\\.com"
          },
          {
            "type": "url_not_matches",
            "pattern": "/login|/auth|/signin|accounts\\.google\\.com"
          }
        ]
      },
      "people-list": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/organization/people$"
          }
        ]
      },
      "onboard-form": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/organization/people/onboard"
          }
        ]
      },
      "person-detail": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/organization/people/[a-z0-9-]+"
          },
          {
            "type": "url_not_matches",
            "pattern": "/onboard|/offboard"
          }
        ]
      },
      "directories": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/organization/directories"
          }
        ]
      },
      "access-grid": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/access/grid"
          }
        ]
      },
      "events": {
        "signals": [
          {
            "type": "url_matches",
            "pattern": "/events$"
          }
        ]
      }
    }
  }
}
