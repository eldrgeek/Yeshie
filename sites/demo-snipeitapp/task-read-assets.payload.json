{
  "_meta": {
    "task": "count-ready-to-deploy-assets",
    "description": "Count assets listed as Ready to Deploy on the hardware page",
    "mode": "exploratory"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://demo.snipeitapp.com/hardware"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 3000ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s3",
      "action": "read",
      "store_as": "page_snapshot"
    },
    {
      "stepId": "s4",
      "action": "js",
      "code": "dumpText('Ready to Deploy')",
      "store_as": "rtd_leaves"
    },
    {
      "stepId": "s5",
      "action": "js",
      "code": "dumpText('Showing')",
      "store_as": "pagination_info"
    }
  ]
}
