{
  "_meta": {
    "layer": 3,
    "name": "github.com Site Model",
    "description": "Hand-authored from well-known stable GitHub UI structure (React Primer component system). Not auto-generated by explore.js — GitHub's write actions require auth and most pages are app-shell rendered.",
    "version": "0.1",
    "site": "github.com",
    "baseUrl": "https://github.com",
    "framework": "react-primer",
    "lastExplored": null,
    "exploredBy": "hand-authored",
    "pagesDiscovered": 0,
    "authRequired": "partial — public repo pages accessible without login; write actions require GitHub session"
  },
  "auth": {
    "type": "github_session",
    "loginPath": "/login",
    "loginFields": ["login", "password"],
    "sessionIndicators": [
      "img[alt*='@']",
      "summary[aria-label*='View profile']",
      "[data-login]"
    ],
    "note": "OAuth SSO supported. Most write actions require session. Public repos readable without auth."
  },
  "stateGraph": {
    "nodes": {
      "homepage": {
        "signals": [{ "type": "url_matches", "pattern": "^https://github\\.com/?$" }],
        "description": "GitHub homepage / dashboard for logged-in users"
      },
      "login": {
        "signals": [{ "type": "url_matches", "pattern": "/login" }],
        "description": "GitHub login page — session not active"
      },
      "repo-home": {
        "signals": [{ "type": "url_matches", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" }],
        "description": "Repository main page (code tab)"
      },
      "repo-issues": {
        "signals": [{ "type": "url_matches", "pattern": "/issues$" }],
        "description": "Issue list for a repository"
      },
      "issue-new": {
        "signals": [{ "type": "url_matches", "pattern": "/issues/new" }],
        "description": "New issue creation form"
      },
      "issue-detail": {
        "signals": [{ "type": "url_matches", "pattern": "/issues/\\d+" }],
        "description": "Individual issue detail page"
      },
      "repo-pulls": {
        "signals": [{ "type": "url_matches", "pattern": "/pulls$" }],
        "description": "Pull request list for a repository"
      },
      "pr-detail": {
        "signals": [{ "type": "url_matches", "pattern": "/pull/\\d+" }],
        "description": "Individual pull request detail page"
      },
      "pr-compare": {
        "signals": [{ "type": "url_matches", "pattern": "/compare" }],
        "description": "PR comparison / creation form"
      },
      "repo-actions": {
        "signals": [{ "type": "url_matches", "pattern": "/actions$" }],
        "description": "GitHub Actions workflows list"
      },
      "actions-run": {
        "signals": [{ "type": "url_matches", "pattern": "/actions/runs/\\d+" }],
        "description": "Individual workflow run detail"
      },
      "repo-releases": {
        "signals": [{ "type": "url_matches", "pattern": "/releases$" }],
        "description": "Releases list page"
      },
      "release-detail": {
        "signals": [{ "type": "url_matches", "pattern": "/releases/tag/" }],
        "description": "Individual release detail page"
      },
      "release-new": {
        "signals": [{ "type": "url_matches", "pattern": "/releases/new" }],
        "description": "New release creation form"
      },
      "repo-settings": {
        "signals": [{ "type": "url_matches", "pattern": "/settings$" }],
        "description": "Repository settings (auth required)"
      },
      "repo-settings-branches": {
        "signals": [{ "type": "url_matches", "pattern": "/settings/branches" }],
        "description": "Branch protection rules settings"
      },
      "file-view": {
        "signals": [{ "type": "url_matches", "pattern": "/blob/" }],
        "description": "File content view"
      },
      "file-edit": {
        "signals": [{ "type": "url_matches", "pattern": "/edit/" }],
        "description": "File editor (auth required)"
      },
      "file-new": {
        "signals": [{ "type": "url_matches", "pattern": "/new/" }],
        "description": "New file creation form (auth required)"
      },
      "repo-forks": {
        "signals": [{ "type": "url_matches", "pattern": "/network/members" }],
        "description": "Fork network / members list"
      },
      "repo-branches": {
        "signals": [{ "type": "url_matches", "pattern": "/branches$" }],
        "description": "Branch list page"
      },
      "search": {
        "signals": [{ "type": "url_matches", "pattern": "/search\\?" }],
        "description": "GitHub search results"
      },
      "explore": {
        "signals": [{ "type": "url_matches", "pattern": "/explore" }],
        "description": "GitHub Explore / trending"
      },
      "gist-list": {
        "signals": [{ "type": "url_matches", "pattern": "gist\\.github\\.com$" }],
        "description": "Gist homepage / discover"
      },
      "gist-detail": {
        "signals": [{ "type": "url_matches", "pattern": "gist\\.github\\.com/[^/]+/[a-f0-9]+" }],
        "description": "Individual gist page"
      },
      "gist-new": {
        "signals": [{ "type": "url_matches", "pattern": "gist\\.github\\.com$" }],
        "description": "New gist creation form (gist.github.com root when logged in)"
      },
      "notifications": {
        "signals": [{ "type": "url_matches", "pattern": "/notifications" }],
        "description": "Notifications inbox (auth required)"
      },
      "user-profile": {
        "signals": [{ "type": "url_matches", "pattern": "^https://github\\.com/[^/]+/?$" }],
        "description": "User or org profile page (ambiguous with repo-home — resolved by presence of pinned repos vs code tab)"
      },
      "org-profile": {
        "signals": [{ "type": "url_matches", "pattern": "^https://github\\.com/[^/]+/?$" }],
        "description": "Organization profile page"
      },
      "repo-create": {
        "signals": [{ "type": "url_matches", "pattern": "^https://github\\.com/new$" }],
        "description": "New repository creation form (auth required)"
      },
      "profile-settings": {
        "signals": [{ "type": "url_matches", "pattern": "/settings/profile" }],
        "description": "User profile settings (auth required)"
      },
      "account-settings": {
        "signals": [{ "type": "url_matches", "pattern": "/settings$" }],
        "description": "Account settings root (auth required)"
      }
    }
  },
  "urlSchema": [
    { "id": "homepage", "pattern": "https://github.com", "description": "Homepage / dashboard" },
    { "id": "repo-home", "pattern": "https://github.com/{owner}/{repo}", "description": "Repository main page" },
    { "id": "repo-issues", "pattern": "https://github.com/{owner}/{repo}/issues", "description": "Issues list" },
    { "id": "issue-new", "pattern": "https://github.com/{owner}/{repo}/issues/new", "description": "New issue form" },
    { "id": "issue-detail", "pattern": "https://github.com/{owner}/{repo}/issues/{number}", "description": "Issue detail" },
    { "id": "repo-pulls", "pattern": "https://github.com/{owner}/{repo}/pulls", "description": "PR list" },
    { "id": "pr-detail", "pattern": "https://github.com/{owner}/{repo}/pull/{number}", "description": "PR detail" },
    { "id": "pr-compare", "pattern": "https://github.com/{owner}/{repo}/compare/{base}...{head}", "description": "PR comparison form" },
    { "id": "file-view", "pattern": "https://github.com/{owner}/{repo}/blob/{branch}/{path}", "description": "File view" },
    { "id": "file-edit", "pattern": "https://github.com/{owner}/{repo}/edit/{branch}/{path}", "description": "File edit" },
    { "id": "file-new", "pattern": "https://github.com/{owner}/{repo}/new/{branch}", "description": "New file form" },
    { "id": "repo-releases", "pattern": "https://github.com/{owner}/{repo}/releases", "description": "Releases list" },
    { "id": "release-new", "pattern": "https://github.com/{owner}/{repo}/releases/new", "description": "New release form" },
    { "id": "release-detail", "pattern": "https://github.com/{owner}/{repo}/releases/tag/{tag}", "description": "Release detail" },
    { "id": "repo-actions", "pattern": "https://github.com/{owner}/{repo}/actions", "description": "Actions list" },
    { "id": "actions-run", "pattern": "https://github.com/{owner}/{repo}/actions/runs/{run_id}", "description": "Workflow run detail" },
    { "id": "repo-settings", "pattern": "https://github.com/{owner}/{repo}/settings", "description": "Repo settings" },
    { "id": "repo-settings-branches", "pattern": "https://github.com/{owner}/{repo}/settings/branches", "description": "Branch protection settings" },
    { "id": "repo-forks", "pattern": "https://github.com/{owner}/{repo}/network/members", "description": "Fork network" },
    { "id": "repo-branches", "pattern": "https://github.com/{owner}/{repo}/branches", "description": "Branches list" },
    { "id": "repo-create", "pattern": "https://github.com/new", "description": "Create new repo" },
    { "id": "search", "pattern": "https://github.com/search?q={query}&type={type}", "description": "Search results" },
    { "id": "explore", "pattern": "https://github.com/explore", "description": "Explore / trending" },
    { "id": "notifications", "pattern": "https://github.com/notifications", "description": "Notifications" },
    { "id": "user-profile", "pattern": "https://github.com/{username}", "description": "User profile" },
    { "id": "profile-settings", "pattern": "https://github.com/settings/profile", "description": "Profile settings" },
    { "id": "account-settings", "pattern": "https://github.com/settings", "description": "Account settings" },
    { "id": "gist-list", "pattern": "https://gist.github.com", "description": "Public gists" },
    { "id": "gist-detail", "pattern": "https://gist.github.com/{username}/{gist_id}", "description": "Gist detail" }
  ],
  "targetRegistry": {
    "global": {
      "search_bar": "[role='combobox'][name='query'], input[name='q'], [data-target='qbsearch-input.inputButton']",
      "session_avatar": "summary[aria-label*='View profile'] img, img[alt*='@']",
      "notifications_bell": "a[href='/notifications']"
    },
    "repo": {
      "star_button": "button[aria-label*='Star this repository'], button[aria-label*='Unstar this repository']",
      "watch_button": "[aria-label*='Watch'], .watch-button",
      "fork_button": "a[href*='/fork'], [aria-label='Fork']",
      "clone_url": "#clone-help-step-1 input, [aria-label*='Clone URL'], input[aria-label*='https://github.com']",
      "description_edit": "button[aria-label='Edit repository metadata']",
      "topics_input": "input[name='topic']",
      "code_tab": "[data-tab-item='i0code-tab'], a[data-tab-item='code-tab']",
      "issues_tab": "[data-tab-item='i1issues-tab'], a[data-tab-item='issues-tab']",
      "pulls_tab": "[data-tab-item='i3pull-requests-tab']",
      "actions_tab": "a[data-tab-item='actions-tab']",
      "settings_tab": "a[href$='/settings']",
      "file_finder": "[data-hotkey='t']",
      "branch_selector": "summary[aria-label*='Switch branches']"
    },
    "issue": {
      "new_issue_button": "a[href*='/issues/new'], [data-hotkey='c']",
      "title_input": "input[name='issue[title]']",
      "body_textarea": "textarea[name='issue[body]'], #new_comment_field",
      "submit_button": "button[type='submit']",
      "comment_textarea": "textarea[name='comment[body]'], #new_comment_field",
      "close_button": "button[name='comment_and_close']",
      "reopen_button": "button[name='comment_and_open']",
      "label_picker": "[aria-label='Labels']",
      "assignees_picker": "[aria-label='Assignees']",
      "milestone_picker": "[aria-label='Milestone']",
      "lock_button": "[aria-label='Lock conversation']",
      "pin_button": "[aria-label='Pin issue']"
    },
    "pr": {
      "title_input": "input[name='pull_request[title]']",
      "body_textarea": "textarea[name='pull_request[body]']",
      "merge_button": "button[data-details-container*='merge'], .merge-button, button[aria-label*='Merge pull request']",
      "squash_merge_button": "button[aria-label*='Squash and merge']",
      "rebase_merge_button": "button[aria-label*='Rebase and merge']",
      "close_button": "button[name='comment_and_close'], [aria-label='Close pull request']",
      "convert_to_draft": "button[aria-label='Convert to draft']",
      "ready_for_review": "button[aria-label='Ready for review']",
      "reviewer_picker": "[aria-label='Reviewers']",
      "approve_button": "button[value='approve']",
      "request_changes_button": "button[value='request_changes']",
      "review_submit": "button[name='pull_request_review[event]']"
    },
    "release": {
      "tag_input": "input[name='tag_name']",
      "target_branch": "[aria-label='Target: ']",
      "title_input": "input[name='release[name]']",
      "body_textarea": "textarea[name='release[body]']",
      "prerelease_checkbox": "input[name='release[prerelease]']",
      "publish_button": "button[data-disable-with*='Publish']",
      "save_draft_button": "button[data-disable-with*='Save draft']"
    },
    "gist": {
      "description_input": "input[name='gist[description]']",
      "filename_input": "input[class*='gist-blob-name']",
      "content_textarea": "textarea[name='gist[contents][][content]'], .CodeMirror textarea",
      "create_button": "button[type='submit'][name='gist[action]']",
      "public_radio": "input[value='0'][name='gist[public]']",
      "secret_radio": "input[value='1'][name='gist[public]']"
    },
    "actions": {
      "rerun_button": "button[data-confirm*='re-run'], [aria-label*='Re-run']",
      "cancel_button": "button[data-confirm*='cancel'], [aria-label*='Cancel']",
      "workflow_run_link": "a[href*='/actions/runs/']"
    },
    "settings": {
      "repo_name_input": "input[name='repo[name]']",
      "delete_repo_input": "input[aria-label*='repository name']",
      "transfer_input": "input[aria-label*='repository name']",
      "visibility_change_button": "button[aria-label*='Change visibility']",
      "archive_button": "button[aria-label*='Archive']",
      "default_branch_rename": "[aria-label*='Rename default branch']"
    }
  }
}
