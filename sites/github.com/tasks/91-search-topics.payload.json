{
  "_meta": {
    "task": "search-topics",
    "description": "Search GitHub topics (tags used for repo categorization). No login required.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "none",
      "note": "Public search accessible without login"
    },
    "params": {
      "query": {
        "required": true,
        "description": "Topic search query (e.g. 'machine-learning')"
      }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-search-topics-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "query": "{{query}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/search?q={{query}}&type=topics"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s2"
    },
    {
      "stepId": "s3",
      "action": "read",
      "store_as": "topic_search_results"
    }
  ]
}
