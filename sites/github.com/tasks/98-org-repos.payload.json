{
  "_meta": {
    "task": "org-repos",
    "description": "List public repositories for a GitHub organization. No login required for public orgs.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none", "note": "Public org repos accessible without login" },
    "params": {
      "org": { "required": true, "description": "Organization name" },
      "sort": { "required": false, "description": "Sort by: 'created', 'updated', 'pushed', 'full_name'", "default": "updated" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-org-repos-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "org": "{{org}}",
    "sort": "{{sort}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/orgs/{{org}}/repositories?q=&sort={{sort}}" },
    { "stepId": "s2", "action": "delay", "ms": 1500 },
    { "stepId": "s3", "action": "read", "store_as": "org_repos" }
  ]
}
