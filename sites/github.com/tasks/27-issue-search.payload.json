{
  "_meta": {
    "task": "issue-search",
    "description": "Search issues on a GitHub repository using a query string. Supports GitHub issue search syntax. Public repos accessible without login.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none_public_repo", "note": "Public repos accessible without login" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "query": { "required": true, "description": "Search query (GitHub issue search syntax)" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-issue-search-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "query": "{{query}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/issues?q={{query}}" },
    { "stepId": "s2", "action": "delay", "ms": 1500 },
    { "stepId": "s3", "action": "read", "store_as": "search_results" }
  ]
}
