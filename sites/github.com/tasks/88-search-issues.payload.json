{
  "_meta": {
    "task": "search-issues",
    "description": "Search issues and pull requests across all of GitHub. No login required for public search.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none", "note": "Public search accessible without login" },
    "params": {
      "query": { "required": true, "description": "Issue search query (e.g. 'is:issue is:open label:bug language:rust')" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-search-issues-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "query": "{{query}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/search?q={{query}}&type=issues" },
    { "stepId": "s2", "action": "delay", "ms": 2000 },
    { "stepId": "s3", "action": "read", "store_as": "issue_search_results" }
  ]
}
