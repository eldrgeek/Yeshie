{
  "_meta": {
    "task": "repo-list-forks",
    "description": "View the fork network and list of forks for a GitHub repository. Public repos accessible without login.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none_public_repo", "note": "Public repos accessible without login" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-repo-list-forks-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/network/members" },
    { "stepId": "s2", "action": "delay", "ms": 1500 },
    { "stepId": "s3", "action": "read", "store_as": "forks_list", "note": "Read fork network members list" }
  ]
}
