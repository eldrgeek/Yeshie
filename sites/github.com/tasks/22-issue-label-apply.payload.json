{
  "_meta": {
    "task": "issue-label-apply",
    "description": "Apply a label to a GitHub issue via the Labels sidebar picker. Requires write access to the repo.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must have write/triage access to apply labels"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "number": {
        "required": true,
        "description": "Issue number"
      },
      "label": {
        "required": true,
        "description": "Label name to apply (must already exist on the repo)"
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-issue-label-apply-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}",
    "label": "{{label}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/issues/{{number}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "[aria-label='Labels'], [data-menu-trigger='labels']",
      "timeout": 8000
    },
    {
      "stepId": "s3",
      "action": "click",
      "selector": "[aria-label='Labels'], [data-menu-trigger='labels']",
      "note": "Open label picker"
    },
    {
      "stepId": "s4",
      "action": "wait_for",
      "selector": ".js-issue-labels, [aria-label*='label filter']",
      "timeout": 5000
    },
    {
      "stepId": "s5",
      "action": "type",
      "selector": "input[aria-label*='Label name filter'], input[placeholder*='Filter labels']",
      "value": "{{label}}"
    },
    {
      "stepId": "s6",
      "action": "click",
      "selector": "[data-name='{{label}}'], [aria-label*='{{label}}']",
      "note": "Click the label to apply it"
    },
    {
      "stepId": "s7",
      "action": "click",
      "selector": "body",
      "note": "Close dropdown by clicking elsewhere"
    },
    {
      "action": "wait_for",
      "selector": "[role=\"alert\"], .flash, .js-flash-alert, [data-testid=\"toast\"]",
      "timeout": 8000,
      "stepId": "s8"
    }
  ]
}
