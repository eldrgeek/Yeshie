{
  "_meta": {
    "task": "search-repos",
    "description": "Search GitHub repositories using GitHub's search with type=Repositories. No login required for public search.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "none",
      "note": "Public search accessible without login"
    },
    "params": {
      "query": {
        "required": true,
        "description": "Search query (GitHub search syntax, e.g. 'machine learning stars:>1000 language:python')"
      }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-search-repos-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "query": "{{query}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/search?q={{query}}&type=repositories"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s2"
    },
    {
      "stepId": "s3",
      "action": "read",
      "store_as": "repo_search_results"
    }
  ]
}
