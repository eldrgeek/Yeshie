{
  "_meta": {
    "task": "notifications-unsubscribe",
    "description": "Unsubscribe from notifications for a GitHub repository (Unwatch / Ignore). Requires active GitHub session.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must be logged in to manage notifications" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-notifications-unsubscribe-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}" },
    { "stepId": "s2", "action": "wait_for", "selector": "[aria-label*='Watch'], [aria-label*='Unwatch'], .watch-button", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "[aria-label*='Unwatch'], .watch-button", "note": "Open watch dropdown" },
    { "stepId": "s4", "action": "delay", "ms": 500 },
    { "stepId": "s5", "action": "click", "selector": "[aria-label*='Ignore'], input[value='ignore'] ~ label", "note": "Select 'Ignore' to stop notifications" },
    { "stepId": "s6", "action": "delay", "ms": 1000 }
  ]
}
