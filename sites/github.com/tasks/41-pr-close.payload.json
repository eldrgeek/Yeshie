{
  "_meta": {
    "task": "pr-close",
    "description": "Close a pull request without merging. Requires write access to the repo.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must have write access to close PRs"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "number": {
        "required": true,
        "description": "PR number"
      },
      "comment": {
        "required": false,
        "description": "Optional comment before closing",
        "default": ""
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-pr-close-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}",
    "comment": "{{comment}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/pull/{{number}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "button[name='comment_and_close'], [aria-label*='Close pull request']",
      "timeout": 8000
    },
    {
      "stepId": "s3",
      "action": "type",
      "selector": "textarea[name='comment[body]'], #new_comment_field",
      "value": "{{comment}}",
      "note": "Add optional comment before closing"
    },
    {
      "stepId": "s4",
      "action": "click",
      "selector": "button[name='comment_and_close'], button[aria-label*='Close pull request']",
      "note": "Close without merging"
    },
    {
      "action": "wait_for",
      "selector": "[role=\"alert\"], .flash, .js-flash-alert, [data-testid=\"toast\"]",
      "timeout": 8000,
      "stepId": "s5"
    }
  ]
}
