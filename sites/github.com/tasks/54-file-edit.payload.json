{
  "_meta": {
    "task": "file-edit",
    "description": "Edit an existing file in a GitHub repository via the web UI. Requires active GitHub session and write access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must have write access to edit files"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "branch": {
        "required": true,
        "description": "Branch to edit the file on"
      },
      "path": {
        "required": true,
        "description": "File path to edit (e.g. README.md)"
      },
      "content": {
        "required": true,
        "description": "New file content (replaces existing)"
      },
      "commit_message": {
        "required": false,
        "description": "Commit message",
        "default": "Edit {{path}}"
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-file-edit-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "branch": "{{branch}}",
    "path": "{{path}}",
    "content": "{{content}}",
    "commit_message": "{{commit_message}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/edit/{{branch}}/{{path}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": ".CodeMirror, .cm-content",
      "timeout": 10000
    },
    {
      "stepId": "s3",
      "action": "click",
      "selector": ".CodeMirror, .cm-content"
    },
    {
      "stepId": "s4",
      "action": "key",
      "key": "ctrl+a, meta+a",
      "note": "Select all existing content"
    },
    {
      "stepId": "s5",
      "action": "type",
      "selector": ".CodeMirror textarea, .cm-content",
      "value": "{{content}}"
    },
    {
      "stepId": "s6",
      "action": "clear",
      "selector": "input[name='commit_message']"
    },
    {
      "stepId": "s7",
      "action": "type",
      "selector": "input[name='commit_message']",
      "value": "{{commit_message}}"
    },
    {
      "stepId": "s8",
      "action": "click",
      "selector": "button[type='submit'][data-disable-with*='Commit'], button[value='propose-changes']",
      "note": "Commit the edit"
    },
    {
      "action": "wait_for",
      "selector": "[role=\"alert\"], .flash, .js-flash-alert, [data-testid=\"toast\"]",
      "timeout": 8000,
      "stepId": "s9"
    }
  ]
}
