{
  "_meta": {
    "task": "issue-reopen",
    "description": "Reopen a closed GitHub issue. Requires write access to the repo.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must have write access to reopen issues"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "number": {
        "required": true,
        "description": "Issue number"
      },
      "comment": {
        "required": false,
        "description": "Optional comment to add when reopening",
        "default": ""
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-issue-reopen-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}",
    "comment": "{{comment}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/issues/{{number}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "button[name='comment_and_open'], [aria-label*='Reopen issue']",
      "timeout": 8000
    },
    {
      "stepId": "s3",
      "action": "type",
      "selector": "textarea[name='comment[body]'], #new_comment_field",
      "value": "{{comment}}",
      "note": "Add optional reopening comment"
    },
    {
      "stepId": "s4",
      "action": "click",
      "selector": "button[name='comment_and_open'], button[aria-label*='Reopen issue']",
      "note": "Reopen the issue"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s5"
    },
    {
      "stepId": "s6",
      "action": "read",
      "store_as": "reopen_result"
    }
  ]
}
