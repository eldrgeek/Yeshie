{
  "_meta": {
    "task": "org-view",
    "description": "View a GitHub organization profile page. No login required for public organizations.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none", "note": "Public org profiles accessible without login" },
    "params": {
      "org": { "required": true, "description": "Organization name" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-org-view-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "org": "{{org}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{org}}" },
    { "stepId": "s2", "action": "delay", "ms": 1500 },
    { "stepId": "s3", "action": "read", "store_as": "org_profile" }
  ]
}
