{
  "_meta": {
    "task": "repo-view",
    "description": "Navigate to a GitHub repository and read its description, stats (stars, forks, watchers), topics, and README preview.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none_public_repo", "note": "Public repos accessible without login" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)", "pattern": "^[a-zA-Z0-9_.-]+$" },
      "repo": { "required": true, "description": "Repo name", "pattern": "^[a-zA-Z0-9_.-]+$" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-repo-view-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "base_url": "https://github.com"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}" },
    { "stepId": "s2", "action": "delay", "ms": 1500 },
    { "stepId": "s3", "action": "read", "store_as": "repo_content", "note": "Read repo homepage — description, star count, fork count, topics, README" }
  ],
  "stateGraph": {
    "nodes": {
      "repo-home": { "signals": [{ "type": "url_matches", "pattern": "/[^/]+/[^/]+$" }] },
      "not-found": { "signals": [{ "type": "text_present", "text": "This is not the web page you are looking for" }] }
    }
  }
}
