{
  "_meta": {
    "task": "pr-request-reviewer",
    "description": "Request a specific reviewer for a GitHub pull request. Requires write access to the repo.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must have write access to request reviewers" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "number": { "required": true, "description": "PR number" },
      "reviewer": { "required": true, "description": "GitHub username to request as reviewer" }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-pr-request-reviewer-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}",
    "reviewer": "{{reviewer}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/pull/{{number}}" },
    { "stepId": "s2", "action": "wait_for", "selector": "[aria-label='Reviewers'], [data-menu-trigger='reviewers']", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "[aria-label='Reviewers'], [data-menu-trigger='reviewers']" },
    { "stepId": "s4", "action": "wait_for", "selector": "input[aria-label*='reviewer filter'], input[placeholder*='Type or choose a name']", "timeout": 5000 },
    { "stepId": "s5", "action": "type", "selector": "input[aria-label*='reviewer filter'], input[placeholder*='Type or choose a name']", "value": "{{reviewer}}" },
    { "stepId": "s6", "action": "click", "selector": "[data-reviewer-name='{{reviewer}}'], [aria-label*='{{reviewer}}']" },
    { "stepId": "s7", "action": "click", "selector": "body", "note": "Close dropdown" },
    { "stepId": "s8", "action": "delay", "ms": 1000 }
  ]
}
