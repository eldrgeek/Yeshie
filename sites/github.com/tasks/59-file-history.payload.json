{
  "_meta": {
    "task": "file-history",
    "description": "View commit history for a specific file in a GitHub repository. Public repos accessible without login.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "none_public_repo",
      "note": "Public repos accessible without login"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "branch": {
        "required": true,
        "description": "Branch or commit SHA"
      },
      "path": {
        "required": true,
        "description": "File path (e.g. src/index.js)"
      }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-file-history-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "branch": "{{branch}}",
    "path": "{{path}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/commits/{{branch}}/{{path}}"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s2"
    },
    {
      "stepId": "s3",
      "action": "read",
      "store_as": "file_history"
    }
  ]
}
