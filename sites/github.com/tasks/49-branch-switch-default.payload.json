{
  "_meta": {
    "task": "branch-switch-default",
    "description": "Change the default branch of a GitHub repository. DESTRUCTIVE — affects all new clones, PRs, and CI workflows. Requires admin access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must have admin access to change default branch" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "new_default": { "required": true, "description": "Branch name to set as new default" }
    },
    "risk": "confirm",
    "needs_live_verification": true
  },
  "runId": "github-branch-switch-default-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "new_default": "{{new_default}}"
  },
  "chain": [
    { "stepId": "guard", "action": "assert", "condition": "false", "message": "DESTRUCTIVE: Changing the default branch affects all new clones and may break existing automation. NEVER execute in testing." },
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/settings/branches" },
    { "stepId": "s2", "action": "wait_for", "selector": "button[aria-label*='Switch default branch'], [data-target*='default-branch']", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "button[aria-label*='Switch default branch'], .js-default-branch-button", "note": "Open default branch rename dialog" },
    { "stepId": "s4", "action": "wait_for", "selector": "input[name*='branch'], [aria-label*='branch name']", "timeout": 5000 },
    { "stepId": "s5", "action": "clear", "selector": "input[name*='branch']" },
    { "stepId": "s6", "action": "type", "selector": "input[name*='branch']", "value": "{{new_default}}" },
    { "stepId": "s7", "action": "click", "selector": "button[type='submit'][data-disable-with*='Update']", "note": "Confirm default branch change" }
  ]
}
