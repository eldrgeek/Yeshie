{
  "_meta": {
    "task": "pr-convert-to-draft",
    "description": "Convert an open PR to draft state, signaling it is not ready for review. Requires write access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must have write access to the repo" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "number": { "required": true, "description": "PR number" }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-pr-convert-to-draft-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/pull/{{number}}" },
    { "stepId": "s2", "action": "wait_for", "selector": "button[aria-label='Convert to draft'], [aria-label*='Still in progress']", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "button[aria-label='Convert to draft']", "note": "Click Convert to draft" },
    { "stepId": "s4", "action": "wait_for", "selector": "button[data-disable-with*='Converting'], dialog", "timeout": 5000 },
    { "stepId": "s5", "action": "click", "selector": "button[data-disable-with*='Converting to draft'], button[type='submit']", "note": "Confirm draft conversion" },
    { "stepId": "s6", "action": "delay", "ms": 1500 }
  ]
}
