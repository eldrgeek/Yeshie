{
  "_meta": {
    "task": "repo-clone-url",
    "description": "Read the HTTPS clone URL from a GitHub repository page. Public repos accessible without login.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "none_public_repo",
      "note": "Public repos accessible without login"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-repo-clone-url-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s2"
    },
    {
      "stepId": "s3",
      "action": "read",
      "store_as": "page_state",
      "note": "Read page to confirm we are on the repo page. The HTTPS clone URL is always https://github.com/{owner}/{repo}.git \u2014 derivable from params or from page_state.pageUrl + .git. GitHub 2025+ Primer React UI removed aria-label from the Code button, making the dropdown selector unreliable without auth."
    }
  ]
}
