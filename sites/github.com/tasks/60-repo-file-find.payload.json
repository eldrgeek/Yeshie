{
  "_meta": {
    "task": "repo-file-find",
    "description": "Use GitHub's file finder (T hotkey) to search for a file by name within a repository. Public repos accessible without login.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "none_public_repo",
      "note": "Public repos accessible without login"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "filename": {
        "required": true,
        "description": "Filename or partial path to search for"
      }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-repo-file-find-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "filename": "{{filename}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s2"
    },
    {
      "stepId": "s3",
      "action": "key",
      "key": "t",
      "note": "Press T to open file finder"
    },
    {
      "stepId": "s4",
      "action": "wait_for",
      "selector": "#tree-finder-field, input[placeholder*='Go to file']",
      "timeout": 5000
    },
    {
      "stepId": "s5",
      "action": "type",
      "selector": "#tree-finder-field, input[placeholder*='Go to file']",
      "value": "{{filename}}"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s6"
    },
    {
      "stepId": "s7",
      "action": "read",
      "store_as": "file_finder_results"
    }
  ]
}
