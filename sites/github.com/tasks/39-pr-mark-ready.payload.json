{
  "_meta": {
    "task": "pr-mark-ready",
    "description": "Mark a draft pull request as ready for review. Requires write access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must have write access to the repo"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      },
      "number": {
        "required": true,
        "description": "PR number (must be in draft state)"
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-pr-mark-ready-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}/pull/{{number}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "button[aria-label='Ready for review'], button[data-disable-with*='Ready for review']",
      "timeout": 8000
    },
    {
      "stepId": "s3",
      "action": "click",
      "selector": "button[aria-label='Ready for review'], button[data-disable-with*='Ready for review']",
      "note": "Mark draft PR as ready for review"
    },
    {
      "action": "wait_for",
      "selector": "[role=\"alert\"], .flash, .js-flash-alert, [data-testid=\"toast\"]",
      "timeout": 8000,
      "stepId": "s4"
    }
  ]
}
