{
  "_meta": {
    "task": "issue-assign",
    "description": "Assign a GitHub issue to a user via the Assignees sidebar picker. Requires write/triage access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must have write or triage access" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "number": { "required": true, "description": "Issue number" },
      "assignee": { "required": true, "description": "GitHub username to assign" }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-issue-assign-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "number": "{{number}}",
    "assignee": "{{assignee}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/issues/{{number}}" },
    { "stepId": "s2", "action": "wait_for", "selector": "[aria-label='Assignees'], [data-menu-trigger='assignees']", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "[aria-label='Assignees'], [data-menu-trigger='assignees']", "note": "Open assignees picker" },
    { "stepId": "s4", "action": "wait_for", "selector": "input[aria-label*='assignee filter'], input[placeholder*='Type or choose a name']", "timeout": 5000 },
    { "stepId": "s5", "action": "type", "selector": "input[aria-label*='assignee filter'], input[placeholder*='Type or choose a name']", "value": "{{assignee}}" },
    { "stepId": "s6", "action": "click", "selector": "[data-assignee-name='{{assignee}}'], [aria-label*='{{assignee}}']", "note": "Select the assignee" },
    { "stepId": "s7", "action": "click", "selector": "body", "note": "Close dropdown" },
    { "stepId": "s8", "action": "delay", "ms": 1000 }
  ]
}
