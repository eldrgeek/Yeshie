{
  "_meta": {
    "task": "repo-unstar",
    "description": "Unstar a GitHub repository. Requires active GitHub session. Clicks the Unstar button on the repo homepage.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": {
      "type": "github_session",
      "note": "Must be logged in to GitHub"
    },
    "params": {
      "owner": {
        "required": true,
        "description": "Repo owner (user or org)"
      },
      "repo": {
        "required": true,
        "description": "Repo name"
      }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-repo-unstar-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}"
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://github.com/{{owner}}/{{repo}}"
    },
    {
      "stepId": "s2",
      "action": "wait_for",
      "selector": "button[aria-label*='Star'], button[aria-label*='Unstar']",
      "timeout": 8000
    },
    {
      "stepId": "s3",
      "action": "click",
      "selector": "button[aria-label*='Unstar this repository']",
      "note": "Click Unstar button \u2014 only fires if currently starred"
    },
    {
      "action": "wait_for",
      "selector": ".application-main",
      "timeout": 8000,
      "stepId": "s4"
    },
    {
      "stepId": "s5",
      "action": "read",
      "selector": "button[aria-label*='Star'], button[aria-label*='Unstar']",
      "store_as": "star_button_after"
    }
  ]
}
