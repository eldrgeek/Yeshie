{
  "_meta": {
    "task": "actions-rerun",
    "description": "Re-run a GitHub Actions workflow run. Requires active GitHub session and write access.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "github_session", "note": "Must have write access to re-run workflows" },
    "params": {
      "owner": { "required": true, "description": "Repo owner (user or org)" },
      "repo": { "required": true, "description": "Repo name" },
      "run_id": { "required": true, "description": "Workflow run ID to re-run" }
    },
    "risk": "safe",
    "needs_live_verification": true
  },
  "runId": "github-actions-rerun-{{timestamp}}",
  "mode": "action",
  "site": "github.com",
  "params": {
    "owner": "{{owner}}",
    "repo": "{{repo}}",
    "run_id": "{{run_id}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/{{owner}}/{{repo}}/actions/runs/{{run_id}}" },
    { "stepId": "s2", "action": "wait_for", "selector": "button[data-confirm*='re-run'], [aria-label*='Re-run'], button[aria-label*='Rerun']", "timeout": 8000 },
    { "stepId": "s3", "action": "click", "selector": "button[data-confirm*='re-run'], [aria-label*='Re-run all jobs']", "note": "Click Re-run all jobs" },
    { "stepId": "s4", "action": "wait_for", "selector": "dialog, button[type='submit']", "timeout": 5000 },
    { "stepId": "s5", "action": "click", "selector": "button[type='submit'][data-disable-with*='Re-run jobs'], button[data-disable-with*='Re-run']", "note": "Confirm re-run" },
    { "stepId": "s6", "action": "delay", "ms": 2000 }
  ]
}
