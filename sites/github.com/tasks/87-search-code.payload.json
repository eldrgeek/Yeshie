{
  "_meta": {
    "task": "search-code",
    "description": "Search GitHub code using type=Code search. No login required for public code search.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "auth": { "type": "none", "note": "Public code search accessible without login" },
    "params": {
      "query": { "required": true, "description": "Code search query (e.g. 'useState language:typescript')" }
    },
    "risk": "safe",
    "needs_live_verification": false
  },
  "runId": "github-search-code-{{timestamp}}",
  "mode": "verification",
  "site": "github.com",
  "params": {
    "query": "{{query}}"
  },
  "chain": [
    { "stepId": "s1", "action": "navigate", "url": "https://github.com/search?q={{query}}&type=code" },
    { "stepId": "s2", "action": "delay", "ms": 2000 },
    { "stepId": "s3", "action": "read", "store_as": "code_search_results" }
  ]
}
