{
  "_meta": {
    "task": "export-data",
    "description": "Trigger ChatGPT data export. Navigates to Settings \u2192 Data controls \u2192 Export data \u2192 Confirm. ChatGPT emails a download link asynchronously \u2014 the skill requests the export and the email-link step is a separate manual/async action.",
    "selfImproving": true,
    "runCount": 0,
    "lastSuccess": null,
    "params": {
      "base_url": {
        "required": false,
        "default": "https://chatgpt.com",
        "description": "ChatGPT home page \u2014 must be logged in"
      }
    },
    "humanSteps": [
      "After skill completes: check your email (mw@mike-wolf.com) for 'Your ChatGPT data export is ready'",
      "Click the download link in the email to get the zip file",
      "Move the downloaded zip to ~/Downloads/chat-exports/"
    ]
  },
  "params": {
    "base_url": "https://chatgpt.com"
  },
  "abstractTargets": {
    "profile_button": {
      "description": "Profile/account button in the bottom-left sidebar",
      "anchors": {
        "ariaLabel": "Open profile menu"
      },
      "fallbackSelectors": [
        "[data-testid='accounts-profile-button']",
        "button[aria-label*='open profile menu' i]",
        "button[aria-label*='account']",
        "[aria-label='Open account menu']",
        "button[aria-haspopup='menu']",
        "nav button:last-child"
      ]
    },
    "settings_menu_item": {
      "description": "Settings option in the account dropdown menu",
      "fallbackSelectors": [
        "[data-testid='settings-menu-item']",
        "a[href*='settings']",
        "button[aria-label='Settings']"
      ]
    }
  },
  "chain": [
    {
      "stepId": "s1",
      "action": "navigate",
      "url": "https://chatgpt.com",
      "note": "Navigate to ChatGPT home"
    },
    {
      "stepId": "s2",
      "action": "assess_state",
      "stateGraph": {
        "nodes": {
          "auth_required": {
            "signals": [
              {
                "type": "url_matches",
                "pattern": "chatgpt\\.com/auth"
              },
              {
                "type": "url_matches",
                "pattern": "accounts\\.openai\\.com"
              }
            ]
          }
        }
      },
      "onMismatch": "continue",
      "note": "Fail fast if not logged in"
    },
    {
      "stepId": "s3",
      "action": "wait_for",
      "target": "profile_button",
      "state": {
        "visible": true
      },
      "timeout": 8000,
      "note": "wait for profile_button before next step (was delay 1500ms)"
    },
    {
      "stepId": "s4",
      "action": "click",
      "target": "profile_button",
      "note": "Open account menu (bottom-left profile button)"
    },
    {
      "stepId": "s5",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 800ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s6",
      "action": "click_text",
      "text": "Settings",
      "note": "Click Settings in the account dropdown"
    },
    {
      "stepId": "s7",
      "action": "wait_for",
      "selector": "[role='dialog'], [role='tablist'], .modal",
      "state": {
        "visible": true
      },
      "timeout": 8000,
      "note": "Wait for Settings dialog to open"
    },
    {
      "stepId": "s8",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 600ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s9",
      "action": "click_text",
      "text": "Data controls",
      "note": "Click Data controls tab in Settings"
    },
    {
      "stepId": "s10",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 800ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s11",
      "action": "click_text",
      "text": "Export",
      "note": "Click Export button in Data controls section (may be 'Export data')"
    },
    {
      "stepId": "s12",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 1000ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s13",
      "action": "click_text",
      "text": "Confirm export",
      "note": "Confirm the export in the modal dialog"
    },
    {
      "stepId": "s14",
      "action": "wait_for",
      "selector": "main, [role='main'], .v-main, .v-data-table, .application-main, #app, #root, [data-testid='app-root']",
      "timeout": 6000,
      "onTimeout": "continue",
      "note": "settle (was delay 1500ms); resolves on content root, proceeds on timeout"
    },
    {
      "stepId": "s15",
      "action": "read",
      "candidates": [
        "[role='dialog'] p",
        "[role='alertdialog'] p",
        ".modal-body p",
        "[role='status']"
      ],
      "store_as": "confirmation_text",
      "note": "Capture confirmation message (should say email was sent)"
    }
  ],
  "site": "chatgpt.com",
  "mode": "exploratory"
}
